# Database
MONGODB_URI=

# Admin authentication
# Use a cryptographically random value of at least 48 characters.
ADMIN_JWT_SECRET=
# Maximum admin session duration in hours (1-24). Recommended: 8.
ADMIN_SESSION_HOURS=8
# Production must be an HTTPS URL, e.g. https://example.com/admin/reset-password
ADMIN_RESET_BASE_URL=http://localhost:3000/admin/reset-password

# One-time super-admin bootstrap
# Remove these values from the environment immediately after npm run admin:create.
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
